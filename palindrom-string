//Check the given string is palindrom?

fun main() {
	val word = "madam"
    val str = "race car"
    val resultWord = isPalindromWord(word)
    val resultString = isPalindromString(str)
    println(resultWord)
    println(resultString)
}

fun isPalindromWord(str: String): Boolean{
    var left = 0
    var right = str.length - 1
    while(left < right){
        if(str[left] != str[right]){
            return false
        }
        left++
        right--
    }
    return true
}

fun isPalindromString(s:String):Boolean{
    var left = 0
    var right = s.length - 1
      while (left < right && !s[left].isLetterOrDigit()) {
        left++
    }
    while (left < right && !s[right].isLetterOrDigit()) {
        right--
    }
    if (s[left].lowercaseChar() != s[right].lowercaseChar()) {
        return false
    }
    return true
}
